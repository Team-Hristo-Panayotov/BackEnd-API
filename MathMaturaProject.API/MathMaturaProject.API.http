@MathMaturaProject.API_HostAddress = http://localhost:5051

GET {{MathMaturaProject.API_HostAddress}}/api/health
Accept: application/json

###

# Register (sets the mm_session cookie)
POST {{MathMaturaProject.API_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "email": "student@example.com",
  "displayName": "Student",
  "password": "correct-horse-battery"
}

###

# Login (sets the mm_session cookie)
POST {{MathMaturaProject.API_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "student@example.com",
  "password": "correct-horse-battery"
}

###

# Current user - 200 with the cookie, 401 without
GET {{MathMaturaProject.API_HostAddress}}/api/auth/me
Accept: application/json

###

# Logout (revokes the session and expires the cookie)
POST {{MathMaturaProject.API_HostAddress}}/api/auth/logout

###
