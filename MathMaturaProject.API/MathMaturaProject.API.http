@MathMaturaProject.API_HostAddress = http://localhost:5051

GET {{MathMaturaProject.API_HostAddress}}/api/health
Accept: application/json

###

### Register. Copy "accessToken" from the reply into @token below.
POST {{MathMaturaProject.API_HostAddress}}/api/auth/register
Content-Type: application/json

{
  "email": "student@example.com",
  "displayName": "Maria",
  "password": "parola123"
}

### Log in
POST {{MathMaturaProject.API_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "student@example.com",
  "password": "parola123"
}

### Who am I? Needs the token.
@token = paste-access-token-here
GET {{MathMaturaProject.API_HostAddress}}/api/auth/me
Authorization: Bearer {{token}}

### Lessons

GET {{MathMaturaProject.API_HostAddress}}/api/lessons
Accept: application/json

###

POST {{MathMaturaProject.API_HostAddress}}/api/lessons
Content-Type: application/json

{
  "title": "Linear equations",
  "section": 0,
  "content": "Solving ax + b = 0.",
  "estimatedMinutes": 20,
  "orderIndex": 1,
  "prerequisiteLessonIds": [],
  "isPublished": true
}

###

@lessonId = 00000000-0000-0000-0000-000000000000

GET {{MathMaturaProject.API_HostAddress}}/api/lessons/{{lessonId}}
Accept: application/json

###

PUT {{MathMaturaProject.API_HostAddress}}/api/lessons/{{lessonId}}
Content-Type: application/json

{
  "title": "Linear equations (updated)",
  "section": 0,
  "content": "Solving ax + b = 0, with examples.",
  "estimatedMinutes": 25,
  "orderIndex": 1,
  "prerequisiteLessonIds": [],
  "isPublished": true
}

###

DELETE {{MathMaturaProject.API_HostAddress}}/api/lessons/{{lessonId}}

###
